{
  "name": "field13",
  "version": "1.0.0",
  "description": "FIELD13 \u2014 AI-native GTM company",
  "main": "index.html",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cf:db:local": "wrangler d1 execute field13-requests --local --file=db/schema.sql",
    "cf:db:remote": "wrangler d1 execute field13-requests --remote --file=db/schema.sql",
    "cf:migrate:local": "wrangler d1 execute field13-requests --local --file=db/migrations/0002_board_value.sql",
    "cf:migrate:remote": "wrangler d1 execute field13-requests --remote --file=db/migrations/0002_board_value.sql",
    "cf:dev": "vite build --mode cfdev && wrangler pages dev dist --port 8788",
    "cf:deploy": "npm run build && wrangler pages deploy dist --project-name field13",
    "cf:seed:local": "wrangler d1 execute field13-requests --local --file=db/seed.sql",
    "cf:seed:remote": "wrangler d1 execute field13-requests --remote --file=db/seed.sql"
  },
  "devDependencies": {
    "vercel": "^54.4.1",
    "vite": "^8.0.14",
    "wrangler": "^4.162.0"
  },
  "keywords": [
    "field13",
    "signal",
    "gtm",
    "b2b",
    "go-to-market"
  ],
  "author": "FIELD13",
  "license": "MIT",
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "three": "^0.170.0"
  }
}
